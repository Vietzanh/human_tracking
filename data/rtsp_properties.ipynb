   "source": [
    "import cv2\n",
    "\n",
    "rtsp_url = \"rtsp://localhost:8554/input\"\n",
    "\n",
    "cap = cv2.VideoCapture(rtsp_url)\n",
    "\n",
    "width = cap.get(cv2.CAP_PROP_FRAME_WIDTH)\n",
    "height = cap.get(cv2.CAP_PROP_FRAME_HEIGHT)\n",
    "\n",
    "print(\"Resolution:\", int(width), \"x\", int(height))\n",
    "\n",
    "cap.release()"
   ]
  }
 ],
